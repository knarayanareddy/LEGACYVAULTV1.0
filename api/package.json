{
  "name": "legacyvault-api",
  "version": "1.0.0",
  "description": "LegacyVault API Gateway - Hardened Production Edition",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/init-db.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --runInBand"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@dha-team/arbundles": "^1.0.4",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.52.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "arweave": "^1.15.7",
    "bs58": "^5.0.0",
    "bullmq": "^5.76.6",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "firebase-admin": "^13.8.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "prom-client": "^15.1.3",
    "resend": "^6.12.3",
    "tweetnacl": "^1.0.3",
    "twilio": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
